NODE_ENV=production
PORT=5000
DB_CLIENT=sqlite
DATABASE_PATH=/data/cybershield.db
DATABASE_URL=
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_QUERY_TIMEOUT_MS=10000
CLIENT_ORIGIN=https://your-demo-frontend.example
CLIENT_ORIGINS=https://your-demo-frontend.example
SESSION_SECRET=replace-with-a-strong-random-secret-of-at-least-32-characters
IDENTIFIER_HASH_SECRET=replace-with-a-different-strong-random-secret
SESSION_MAX_AGE=86400000
DEMO_MODE=true
DEMO_ADMIN_EMAIL=admin@cybershield.demo
DEV_OTP=123456
DISABLE_AUTHENTICATION=false
EMAIL_PROVIDER=development
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_MAX_RETRIES=3
EMAIL_TIMEOUT_MS=5000
EVIDENCE_STORAGE_PROVIDER=local
EVIDENCE_STORAGE_PATH=/data/evidence
MAX_EVIDENCE_FILE_SIZE=5242880
MAX_EVIDENCE_FILES_PER_COMPLAINT=5
LOG_LEVEL=info
TRUST_PROXY_HOPS=1
SERVER_REQUEST_TIMEOUT_MS=30000
SERVER_HEADERS_TIMEOUT_MS=35000
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=15000
RATE_LIMIT_AI_ASSISTANT=15
RATE_LIMIT_CHAT=20

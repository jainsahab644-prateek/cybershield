{
  "name": "cybershield-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SQLite-backed API and static server for the CyberShield educational portal",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "check": "node scripts/check-syntax.js",
    "lint": "eslint --config eslint.config.js src scripts tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/integration && node scripts/test-evidence.js && node scripts/test-admin.js && node scripts/test-notifications.js && node scripts/test-suspicious.js && node scripts/test-content.js",
    "test:coverage": "vitest run --coverage",
    "smoke:frontend": "node scripts/frontend-smoke-check.js",
    "verify": "npm run lint && npm run check && npm run smoke:frontend && npm test",
    "db:migrate": "node scripts/database-migrate.js",
    "db:status": "node scripts/database-status.js",
    "db:migrate:postgres": "node scripts/migrate-sqlite-to-postgres.js",
    "db:backup": "node scripts/backup-database.js",
    "perf:test": "node scripts/performance-test.js",
    "test:evidence": "node scripts/test-evidence.js",
    "test:admin": "node scripts/test-admin.js",
    "test:notifications": "node scripts/test-notifications.js",
    "test:suspicious": "node scripts/test-suspicious.js",
    "test:content": "node scripts/test-content.js",
    "admin:promote": "node scripts/promote-admin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "file-type": "^22.0.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "serverless-http": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
